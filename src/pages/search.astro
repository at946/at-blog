---
export const prerender = true;

import DefaultPageLayout from '@/layouts/default.astro';
---

<DefaultPageLayout pageTitle="検索">
  <div class="mb-8">
    <input
      id="search-input"
      type="search"
      placeholder="記事を検索"
      class="w-full rounded border-2 border-gray-500 px-4 py-3"
      autocomplete="off"
      autofocus
    />
  </div>

  <div id="search-status" class="mb-4 text-sm"></div>

  <div id="search-results"></div>
</DefaultPageLayout>

<script>
  import Fuse from 'fuse.js';

  type Article = {
    slug: string;
    tags: string[];
    title: string;
    content: string;
  }

  const input = document.querySelector<HTMLInputElement>('#search-input');
  const status = document.querySelector<HTMLElement>('#search-status');
  const results = document.querySelector<HTMLElement>('#search-results');

  if (!input || !status || !results) {
    throw new Error('Search elements not found');
  }

  const response = await fetch('/search-index.json');
  const articles: Article[] = await response.json();

  const fuse = new Fuse(articles, {
    keys: [
      { name: 'title', weight: 0.4 },
      { name: "tags", weight: 0.4 },
      { name: 'content', weight: 0.2 }
    ],
    threshold: 0.3,
    includeMatches: true,
    ignoreLocation: true,
    minMatchCharLength: 2
  });

  const escapeHtml = (text: string) => {
    return text
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  };

  const highlight = (text: string, indices: readonly [number, number][]) => {
    let result = "";
    let lastIndex = 0;

    for (const [start, end] of indices) {
      result += text.slice(lastIndex, start);
      result += `<mark class="rounded px-1 py-0.5 mx-1">${escapeHtml(text.slice(start, end + 1))}</mark>`;
      lastIndex = end + 1;
    }

    result += text.slice(lastIndex);

    return result;
  }

  const createExcerpt = (text: string, indices: readonly [number, number][]) => {
    if (indices.length === 0) {
      return '';
    }
    
    const radius: number = 100;
    const [start, end] = indices[0];
    const excerptStart: number = Math.max(0, start - radius);
    const excerptEnd: number = Math.min(text.length, end + radius);
    const prefix: string = excerptStart > 0 ? "..." : "";
    const suffix: string = excerptEnd < text.length ? "..." : "";
    const excerpt: string = text.slice(excerptStart, excerptEnd);

    const adjustedIndices = indices.filter(([matchStart, matchEnd]) => {
      return matchEnd >= excerptStart && matchStart < excerptEnd;
    })
    .map(([matchStart, matchEnd]) => [
      Math.max(matchStart, excerptStart) - excerptStart,
      Math.min(matchEnd, excerptEnd - 1) - excerptStart,
    ] as [number, number]);

    return `${prefix}${highlight(excerpt, adjustedIndices)}${suffix}`;
  }

  const renderResults = (query: string) => {
    if (!query.trim()) {
      status.textContent = '';
      results.innerHTML = '';
      return;
    }

    const searchResults = fuse.search(query);

    status.textContent = `${searchResults.length}件`;

    results.innerHTML = searchResults
      .map(({ item, matches }) => {
        const titleMatch = matches?.find((match) => match.key === "title");
        const tagsMatch = matches?.filter((match) => match.key === "tags");
        const contentMatch = matches?.find((match) => match.key === "content");

        const title: string = titleMatch ? highlight(item.title, titleMatch.indices) : item.title;
        const tags: string[] = item.tags?.map((tag, index) => {
          const match = tagsMatch?.find((match) => match.refIndex === index);
          return match ? highlight(tag, match.indices) : escapeHtml(tag);
        });
        const excerpt: string = contentMatch ? createExcerpt(item.content, contentMatch.indices) : "";

        return `
          <a
            href="/blog/${item.slug}/"
            class="mb-4 border-2 border-gray-400 p-3 rounded shadow inline-block transition duration-300 hover:shadow-xl hover:border-primary hover:scale-105 hover:border-3"
          >
            <p class="font-bold text-lg mb-4">${title}</p>
            ${
              !!tags
              ? `<div class="flex gap-3 flex-wrap">
                  ${tags.map((tag) => `<span class="text-sm font-medium">${tag}</span>`).join("")}
                </div>`
              : ""
            }
            ${
              excerpt
              ? `<p class="mt-2 text-sm font-medium text-gray-500 dark:text-gray-400 leading-loose">${excerpt}</p>`
              : ""
            }
          </a>
        `;
      })
      .join('');
  };

  input.addEventListener('input', () => {
    renderResults(input.value);
  });

  const params = new URLSearchParams(location.search);
  const query = params.get('q');

  if (query) {
    input.value = query;
    renderResults(query);
  }
</script>