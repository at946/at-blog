---
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import { getIcon } from '@/utils/getIcon';
import Link from './mdoc/Link.astro';

interface Props {
	headingText: string;
	posts: CollectionEntry<'blog'>[];
	class?: string;
}

const { headingText, posts } = Astro.props;
---

{ posts.length > 0 &&
	<div class={Astro.props.class}>
		<h2 class="text-2xl font-semibold mb-2">{headingText}</h2>
		<ul class="list-disc pl-5">
			{ posts.map((post) => (
				<li class="py-1.5">
					<Link href={post.data.externalUrl ?? `${post.id}`} class="font-medium underline underline-offset-4 hover:font-bold hover:text-primary">
						<Icon name={getIcon(post.data.type)} class="inline align-middle mr-1" />
						<span>{post.data.title}</span>
						{ post.data.externalUrl && <Icon name="mdi:external-link" class="inline align-middle ml-1" /> }
					</Link>
				</li>
			))}
		</ul>
	</div>
}