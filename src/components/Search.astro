---
import Search from 'astro-pagefind/components/Search.astro';
---

<div id="search-box-wrapper">
  <Search />
</div>

<script>
  function setupImeEnterBlocker() {
    const wrapper = document.getElementById('search-box-wrapper');
    if (!wrapper) return;

    // astro-pagefindが内部で生成するinput要素をキャッチ
    // コンポーネント生成完了を待つため、少し遅延させてイベントを登録
    setTimeout(() => {
      const input = wrapper.querySelector('input');
      
      if (input) {
        input.addEventListener('keydown', (e) => {
          // IMEの未確定状態かどうかを判定
          if (e.isComposing) {
            if (e.key === 'Enter') {
              e.stopImmediatePropagation();
              e.preventDefault();
            }
          }
        }, { capture: true }); // キャプチャフェーズでPagefindより先にイベントを捕捉
      }
    }, 400);
  }

  setupImeEnterBlocker();
</script>