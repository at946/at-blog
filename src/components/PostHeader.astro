---
import { Icon } from 'astro-icon/components';

interface Props {
	title: string;
	publicationDate: Date;
	readingTime: number;
	class?: string;
}

const { title, publicationDate, readingTime } = Astro.props;
---
<div class:list={["text-center md:text-left", Astro.props.class]}>
  <div class="flex justify-between mb-5">
    <span class="font-medium">
      { new Intl.DateTimeFormat('ja-JP', { dateStyle: 'long' }).format(publicationDate)}
    </span>
    <span class="flex gap-1 items-center font-medium">
      <Icon name="mdi:clock-outline" size="20" />
      <span>{ readingTime }min</span>
    </span>
  </div>
  <h1 class="text-3xl leading-snug font-bold mb-4">
    { title }
  </h1>
  <div class="flex gap-2 flex-wrap justify-center md:justify-start mb-2 text-base">
  </div>
</div>
