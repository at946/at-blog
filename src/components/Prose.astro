    'prose dark:prose-invert dark:prose-dark md:prose-md',
    'max-w-full leading-loose tracking-widest',
    'prose-h2:my-20 prose-h2:font-extrabold prose-h2:leading-loose',
    'prose-h3:my-16 prose-h3:font-extrabold prose-h3:leading-loose',
    'prose-p:font-medium prose-p:my-12',
    'prose-li:font-medium',
    'prose-td:font-medium',
    'prose-th:font-medium',
    Astro.props.class,
  ]}
>
  <slot />
</article>