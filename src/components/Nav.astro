---
import { NAV_ITEMS } from '@/config';

interface Props {
	class?: string;
}

const isActive = (path: string) => {
	const pathname = Astro.url.pathname;
	if (path === '/blog') {
		return pathname === '/blog' || /^\/blog\/\d+\/?$/.test(pathname);
	}
	return pathname === path;
};
---
<nav class={Astro.props.class}>
  <ul class="flex justify-center gap-8 text-xl">
    {
      Object.keys(NAV_ITEMS).map(navItemKey =>
        <li class="underline-offset-8 font-bold capitalize">
          {
            isActive(NAV_ITEMS[navItemKey].path)
            ?
              <span class="underline text-primary">
                {NAV_ITEMS[navItemKey].title}
              </span>
            : <a
                class="hover:underline"
                href={NAV_ITEMS[navItemKey].path}
              >
                {NAV_ITEMS[navItemKey].title}
              </a>
          }
      </li>)
    }
  </ul>
</nav>
