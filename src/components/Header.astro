---
import { Icon } from 'astro-icon/components';
import { SITE } from '@/config';
import ModeSwitcherBtn from './ModeSwitcherBtn.svelte';
import Link from './mdoc/Link.astro';

interface Props {
	className?: string;
}

const { className } = Astro.props;
---

<header class={className}>
  <div class="flex justify-between items-center mb-6 md:mb-2">
    <div class="text-4xl font-extrabold text-primary">
      <Link class="inline-block" href="/">{ SITE.name }</Link>
    </div>
    <div class="flex justify-end">
      <nav>
        <ul class="flex gap-3">
          <li>
            <Link href="/search" title="検索" class="hover:text-link">
              <Icon name="mdi:search" class="text-2xl" />
            </Link>
          </li>
          <li>
            <Link href="/rss.xml" title="RSSを表示" class="hover:text-link">
              <Icon name="mdi:rss" class="text-2xl" />
            </Link>
          </li>
          <li class="hover:text-link">
            <ModeSwitcherBtn client:visible />
          </li>
        </ul>
      </nav>
    </div> 
  </div>
</header>
