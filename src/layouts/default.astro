---
import BaseHead from '@/components/BaseHead.astro';
import MainLayout from '@/layouts/MainLayout.astro';

interface Props {
	pageTitle?: string;
	description?: string;
}

const { pageTitle, description }: Props = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <BaseHead pageTitle={pageTitle} description={description} />
  </head>
  <MainLayout>
    <slot />
  </MainLayout>
</html>
