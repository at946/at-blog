---
import type { CollectionEntry } from 'astro:content';
import { getEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseHead from '@/components/BaseHead.astro';
import Codoc from '@/components/Codoc.astro';
import Link from '@/components/mdoc/Link.astro';
import PostHeader from '@/components/PostHeader.astro';
import Prose from '@/components/Prose.astro';
import RelatedPosts from '@/components/RelatedPosts.astro';
import ShareButtons from '@/components/ShareButtons.astro';
import { PROFILE_PAGE_URLS } from '@/config';
import similarityListJson from '@/data/similarity-list.json';
import PostMainLayout from '@/layouts/PostMainLayout.astro';

interface Props {
	content: CollectionEntry<'blog'>['data'];
	description: string;
	id: string;
	readingTime: number;
}

const { content, description, id, readingTime } = Astro.props;

const similarityList = similarityListJson.find((item) => item.slug === id);
const similarArticles: CollectionEntry<'blog'>[] = (
	await Promise.all(
		similarityList?.similarArticles.map((article) =>
			getEntry('blog', article.slug),
		) ?? [],
	)
).filter((post): post is CollectionEntry<'blog'> => post !== undefined);
const differentPerspectives: CollectionEntry<'blog'>[] = (
	await Promise.all(
		similarityList?.differentPerspectiveArticles.map((article) =>
			getEntry('blog', article.slug),
		) ?? [],
	)
).filter((post): post is CollectionEntry<'blog'> => post !== undefined);
---

<!doctype html>
<html lang="ja">
  <head>
    <BaseHead pageTitle={content.title} description={description} />
  </head>
  <PostMainLayout>
    <PostHeader title={content.title} publicationDate={content.publicationDate} readingTime={readingTime} tags={content.tags} class="mb-4" data-pagefind-body />

    <Prose class="mb-20">
			{!!content.summary && (
				<h2 class="mt-10! mb-1!">３行まとめ</h2>
				<ul>{content.summary.map((summary) => (<li>{summary}</li>))}</ul>
				<hr class="border-gray-300" />
			)}
      <slot />
    </Prose>

    <ShareButtons class="mb-20" blogTitle={content.title} />

    <Codoc />

    <RelatedPosts headingText='Related Posts' posts={similarArticles} class="mt-15 mb-10" />

    <RelatedPosts headingText="Different Perspectives" posts={differentPerspectives} />
  </PostMainLayout>
</html>

