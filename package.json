{
	"name": "at-blog",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.22.0",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"check:astro": "astro check",
		"check:type": "tsc --project tsconfig.json --pretty --noEmit",
		"biome:check": "biome check src",
		"biome:write": "biome check --write src",
		"lint:markdown": "markdownlint-cli2 {*,.*}/**/*.{md,mdx,mdoc}",
		"lint:markdown:fix": "markdownlint-cli2 --fix {*,.*}/**/*.{md,mdx,mdoc}",
		"create:article": "bash utils/commands/create-article.sh",
		"lefthook": "lefthook run pre-commit",
		"add:amazonLink": "python3 utils/python/addAmazonItem.py",
		"generate:embedding": "tsx utils/similarity/generateEmbeddingJson.ts",
		"generate:similarity": "tsx utils/similarity/generateSimilarityJson.ts",
		"generate:tags": "tsx utils/generate-tags",
		"generate:search-index": "tsx utils/search/createSearchIndex.ts",
		"generate:ogp": "tsx utils/generate-ogp",
		"reinstall": "pnpm clean --lockfile && pnpm i"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@astrojs/partytown": "^2.1.7",
		"@astrojs/rss": "^4.0.18",
		"@astrojs/sitemap": "^3.7.3",
		"@astrojs/svelte": "^9.0.0",
		"@biomejs/biome": "2.5.9",
		"@tailwindcss/aspect-ratio": "^0.4.2",
		"@tailwindcss/typography": "^0.5.19",
		"@types/gtag.js": "^0.0.20",
		"@types/katex": "^0.16.8",
		"@types/node": "^26.0.0",
		"astro": "^7.0.0",
		"astro-icon": "^1.1.5",
		"dotenv": "^17.4.2",
		"fast-glob": "^3.3.3",
		"globby": "^16.2.0",
		"gray-matter": "^4.0.3",
		"lefthook": "^2.1.9",
		"markdownlint-cli2": "^0.23.0",
		"svelte": "^5.56.1",
		"tailwindcss": "^4.3.1",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@astrojs/markdoc": "^2.0.0",
		"@astrojs/react": "^6.0.0",
		"@fontsource/zen-kaku-gothic-new": "^5.2.7",
		"@google/genai": "^2.15.0",
		"@iconify-json/cib": "^1.2.3",
		"@iconify-json/fa6-brands": "^1.2.6",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify-json/ri": "^1.2.10",
		"@iconify-json/simple-icons": "^1.2.85",
		"@tailwindcss/vite": "^4.3.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"astro-expressive-code": "^0.44.0",
		"budoux": "^0.9.0",
		"clsx": "^2.1.1",
		"fuse.js": "^7.5.0",
		"katex": "^0.18.0",
		"mermaid": "^11.15.0",
		"ogp-parser": "^0.8.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"satori": "^0.33.3",
		"sharp": "^0.35.3"
	}
}
